{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lsq-site-operations",
  "main": "server/src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Serves built SPA (web/dist); Worker owns /api/*. Build web before deploy.
  "assets": {
    "binding": "ASSETS",
    "directory": "./web/dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    // Inbound ticket address domain: <ticketId>@TICKET_EMAIL_DOMAIN (D25)
    "TICKET_EMAIL_DOMAIN": "ticket.lansburysquare.co.uk",
    // Notifications/OTP sender (MailerSend); board mailbox for reports/chases.
    "MAIL_FROM": "ops@lansburysquare.co.uk",
    "MAIL_FROM_NAME": "Lansbury Square",
    // Live site: logo and ticket links in outgoing mail (D35).
    "APP_URL": "https://lansburysquare.co.uk",
    "BOARD_EMAIL": "board@lansburysquare.co.uk",
    // Main domain for board-provisioned forward aliases (D26), and the CF ids
    // the alias endpoint calls Email Routing with (token: secret CF_EMAIL_TOKEN).
    "MAIL_DOMAIN": "lansburysquare.co.uk",
    "CF_ACCOUNT_ID": "f453e6f1c34f3584556b0ad876e3048e",
    "CF_ZONE_ID": "3f4b1555020a108e8260f04017349ba8",
    // Day of month the monthly board report fires (tracks the meeting schedule,
    // not month-end). Clamped to the last day in shorter months.
    "REPORT_DAY_OF_MONTH": "20"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lsq",
      "database_id": "3c483ac5-23db-40a4-a0ef-69e94c786281",
      "migrations_dir": "migrations"
    }
  ],
  // Year-end score snapshots (D21): the official figures once a service year ends.
  "r2_buckets": [
    { "binding": "SNAPSHOTS", "bucket_name": "lsq-score-snapshots" },
    // Inbound mail originals + attachments, written by the ai Worker; the
    // server only reads them to serve ticket attachments (D28).
    { "binding": "MAIL", "bucket_name": "lsq-inbound-raw" }
  ],
  // No Workers AI binding here: this Worker does no AI. Ticket categories are
  // chosen by the creator (or left for an agent); the only AI use is inbound
  // email summarisation, which lives in the separate `lsq-ai` Worker.
  "unsafe": {
    "bindings": [
      // Native rate limiter: 10 hits / 60s per key. Keys are `ip:<addr>`,
      // `mail:<email>` (request), `vrf:<addr>` (verify). period must be 10|60.
      {
        "name": "OTP_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      },
      // Lax global per-IP cap (billing/DoS backstop) applied to every endpoint.
      {
        "name": "API_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 300, "period": 60 }
      }
    ]
  },
  "triggers": {
    // Daily 02:00 UTC: chase pass + monthly board report on REPORT_DAY_OF_MONTH.
    "crons": ["0 2 * * *"]
  }
  // Secrets (`wrangler secret put <NAME>`): MAILERSEND_API_KEY (outbound mail),
  // CF_EMAIL_TOKEN (registers alias destinations, D26). See architecture.md →
  // "Domain & mail DNS".
  // Inbound email is NOT handled here — it routes to the separate `lsq-email`
  // Worker (see /email/wrangler.jsonc), which queues to `lsq-ai` for processing.
}
